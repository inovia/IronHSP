;============================================================
;  アルゴリズム 06〜10: 文字列検索 / パターンマッチ
;    06. KMP 文字列検索
;    07. Boyer-Moore (bad character rule)
;    08. Rabin-Karp (rolling hash)
;    09. Z-function
;    10. Manacher (最長回文)
;============================================================

#include "hsp3cl_net_64.as"

; ----- 06. KMP -----
#module
#defcfunc kmp_find str _hay, str _pat, \
	local n, local m, local i, local j
	n = strlen(_hay) : m = strlen(_pat)
	if m == 0 : return 0
	if m > n : return -1
	dim lps, m
	; failure 関数
	j = 0
	for i, 1, m
		while (j > 0) & (peek(_pat, i) != peek(_pat, j)) : j = lps(j - 1) : wend
		if peek(_pat, i) == peek(_pat, j) : j++
		lps(i) = j
	next
	i = 0 : j = 0
	while i < n
		if peek(_hay, i) == peek(_pat, j) : i++ : j++
		if j == m : return i - j
		if (i < n) & (peek(_hay, i) != peek(_pat, j)) {
			if j > 0 : j = lps(j - 1) : else : i++
		}
	wend
	return -1
#global

; ----- 07. Boyer-Moore (bad char 簡易版) -----
#module
#defcfunc bm_find str _hay, str _pat, \
	local n, local m, local i, local j, local shift, local c
	n = strlen(_hay) : m = strlen(_pat)
	if m == 0 : return 0
	if m > n : return -1
	dim bad, 256
	repeat 256 : bad(cnt) = -1 : loop
	for i, 0, m : bad(peek(_pat, i)) = i : next
	i = 0
	while i <= n - m
		j = m - 1
		while (j >= 0) & (peek(_pat, j) == peek(_hay, i + j)) : j--
		if j < 0 : return i
		c = peek(_hay, i + j)
		shift = j - bad(c)
		if shift < 1 : shift = 1
		i += shift
	wend
	return -1
#global

; ----- 08. Rabin-Karp (mod 2^31-1) -----
#module
#defcfunc rabin_karp str _hay, str _pat, \
	local n, local m, local i, local h, local phash, local hhash, local BASE, local MOD
	BASE = 131 : MOD = 2147483647
	n = strlen(_hay) : m = strlen(_pat)
	if m == 0 : return 0
	if m > n : return -1
	phash = 0 : hhash = 0 : h = 1
	repeat m - 1 : h = h * BASE \ MOD : loop
	for i, 0, m
		phash = (phash * BASE + peek(_pat, i)) \ MOD
		hhash = (hhash * BASE + peek(_hay, i)) \ MOD
	next
	for i, 0, n - m + 1
		if phash == hhash {
			; verify
			dup_hit = 1
			repeat m
				if peek(_pat, cnt) != peek(_hay, i + cnt) : dup_hit = 0 : break
			loop
			if dup_hit : return i
		}
		if i < n - m {
			hhash = ((hhash - peek(_hay, i) * h) * BASE + peek(_hay, i + m)) \ MOD
			if hhash < 0 : hhash += MOD
		}
	next
	return -1
#global

; ----- 09. Z-function -----
;  文字列の各位置について「先頭との一致長」を返す配列を構築
#module
#deffunc z_function var _s, array _out, local n, local i, local l, local r
	n = strlen(_s)
	dim _out, n
	if n == 0 : return
	_out(0) = n
	l = 0 : r = 0
	for i, 1, n
		if i < r {
			_out(i) = (r - i < _out(i - l)) * (r - i) + (r - i >= _out(i - l)) * _out(i - l)
		}
		while (i + _out(i) < n) & (peek(_s, _out(i)) == peek(_s, i + _out(i))) : _out(i)++ : wend
		if i + _out(i) > r : l = i : r = i + _out(i)
	next
	return
#global

; ----- 10. Manacher (最長回文) -----
#module
#defcfunc manacher_longest var _s, \
	local n, local i, local t, local c, local r, local best_i, local best_p
	n = strlen(_s)
	if n == 0 : return ""
	; T = ^ # s[0] # s[1] # ... # s[n-1] # $
	sdim t_buf, 2 * n + 4
	poke t_buf, 0, '^'
	poke t_buf, 1, '#'
	for i, 0, n
		poke t_buf, 2 + i * 2,     peek(_s, i)
		poke t_buf, 2 + i * 2 + 1, '#'
	next
	poke t_buf, 2 + n * 2 + 1, '$'
	t = 2 * n + 3
	dim p, t
	c = 0 : r = 0
	for i, 1, t - 1
		if r > i : p(i) = (p(2 * c - i) < r - i) * p(2 * c - i) + (p(2 * c - i) >= r - i) * (r - i)
		while peek(t_buf, i + p(i) + 1) == peek(t_buf, i - p(i) - 1) : p(i)++ : wend
		if i + p(i) > r : c = i : r = i + p(i)
	next
	best_i = 0 : best_p = 0
	for i, 1, t - 1
		if p(i) > best_p : best_p = p(i) : best_i = i
	next
	sdim ret, best_p + 1
	for i, 0, best_p
		poke ret, i, peek(_s, (best_i - best_p) / 2 + i)
	next
	poke ret, best_p, 0
	return ret
#global

; ===== デモ =====
	mes "=== 文字列検索 ==="
	hay = "ABAAABCDABAABCABAB" : pat = "ABAB"
	mes strf("KMP(%s, %s) = %d",        hay, pat, kmp_find(hay, pat))
	mes strf("Boyer-Moore(%s, %s) = %d", hay, pat, bm_find(hay, pat))
	mes strf("Rabin-Karp(%s, %s) = %d",  hay, pat, rabin_karp(hay, pat))

	mes ""
	mes "=== Z-function ==="
	z_function "aabcaabxaaz", z
	sdim zline, 128
	zline = "Z = "
	repeat length(z)
		zline += "" + z(cnt) + " "
	loop
	mes zline

	mes ""
	mes "=== Manacher ==="
	s = "babad"
	mes strf("Longest palindrome(%s) = '%s'", s, manacher_longest(s))
	s = "forgeeksskeegfor"
	mes strf("Longest palindrome(%s) = '%s'", s, manacher_longest(s))
	end 0
