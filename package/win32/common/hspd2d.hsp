; WIC pixel formats / container formats (16 byte GUID, IIDFromString でパース)
#define GUID_WICPixelFormat32bppPBGRA  "{6fddc324-4e03-4bfe-b185-3d77768dc910}"
#define GUID_WICPixelFormat32bppBGRA   "{6fddc324-4e03-4bfe-b185-3d77768dc90f}"
; Container formats (encoder GUIDs)
#define GUID_ContainerFormatBmp        "{0af1d87e-fcfe-4188-bdeb-a7906471cbe3}"
#define GUID_ContainerFormatPng        "{1b7cfaf4-713f-473c-bbcd-6137425faeaf}"
