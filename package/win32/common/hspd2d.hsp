#comfunc d2d_SCB_SetColor 8 var
#comfunc d2d_SCB_Release 2

; --- IWICImagingFactory (CoCreate 可能な唯一のもの) ---
#usecom IWICImagingFactory IID_IWICImagingFactory CLSID_WICImagingFactory
; CreateDecoderFromFilename(LPCWSTR file, REFGUID vendor, DWORD access, WICDecodeOptions opt, IWICBitmapDecoder** out)
#comfunc d2d_WIC_CreateDecoderFromFilename 3 wstr, int, int, int, var
#comfunc d2d_WIC_CreateEncoder 8 var, int, var
#comfunc d2d_WIC_CreateFormatConverter 10 var
#comfunc d2d_WIC_CreateStream 14 var
; CreateBitmap(UINT w, UINT h, REFGUID pixelFormat, WICBitmapCreateCacheOption, IWICBitmap** out)
#comfunc d2d_WIC_CreateBitmap 17 int, int, var, int, var
