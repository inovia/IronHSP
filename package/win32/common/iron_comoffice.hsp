	_vis = 0
	if length(_opt) >= 1 : _vis = _opt(0)
	_com_load_cs
	newnet _h, "HspComOffice"
	mcall _h, "WordStart", _r, _vis
	return int("" + _r)

#deffunc word_open str path, local _h, local _r
