;============================================================
;   iron_fs.hsp - File / Folder operations
;
;   Win32 API + HSP. External DLL not needed.
;   HSP standard: exist/delete/mkdir/chdir/dirlist/bload/bsave
;   This module adds: copy/move/rename/rmdir/filesize/attr/
;   glob/walk/readlines/writelines/tempfile/touch
;
;   API:
;     === File ===
;     fs_copy "src", "dst"           Copy file → stat (0=ok)
;     fs_move "src", "dst"           Move/rename → stat
;     fs_rename "old", "new"         Rename → stat
;     fs_size("path")                File size in bytes
;     fs_attr("path")                File attributes (bitmask)
;     fs_is_readonly("path")         Read-only check → 1/0
;     fs_set_readonly "path", sw     Set read-only
;     fs_is_hidden("path")           Hidden check → 1/0
;     fs_touch "path"                Create empty / update timestamp
;     fs_readtext("path")            Read entire text file → string
;     fs_writetext "path", "text"    Write text file (overwrite)
;     fs_appendtext "path", "text"   Append text to file
;     fs_tempfile()                  Generate temp file path
;     fs_ext("path")                 Get extension
;     fs_basename("path")            Get filename without dir
;     fs_dirname("path")             Get directory part
;
;     === Folder ===
;     fs_mkdir_p "path"              Create dirs recursively (mkdir -p)
;     fs_rmdir_r "path"              Remove directory recursively
;     fs_copydir "src", "dst"        Copy directory tree
;     fs_listfiles "dir", "*.txt"    List files → refstr (newline sep)
;     fs_listdirs "dir"              List subdirs → refstr
;     fs_walk "dir"                  Walk all files recursively → refstr
;     fs_dirsize("dir")              Total size of directory
;     fs_is_dir("path")              Is directory → 1/0
;     fs_is_file("path")             Is file → 1/0
;============================================================
#ifndef __iron_fs_hsp__
#define __iron_fs_hsp__

#module iron_fs

#uselib "kernel32.dll"
#cfunc _CopyFileA        "CopyFileA" str, str, int
#cfunc _MoveFileA        "MoveFileA" str, str
#cfunc _DeleteFileA      "DeleteFileA" str
#cfunc _GetFileAttributesA "GetFileAttributesA" str
#cfunc _SetFileAttributesA "SetFileAttributesA" str, int
#cfunc _CreateDirectoryA "CreateDirectoryA" str, int
#cfunc _RemoveDirectoryA "RemoveDirectoryA" str
#cfunc _GetTempFileNameA "GetTempFileNameA" str, str, int, var
#cfunc _GetTempPathA2    "GetTempPathA" int, var
#cfunc _FindFirstFileA   "FindFirstFileA" str, var
#cfunc _FindNextFileA    "FindNextFileA" int, var
#cfunc _FindClose2       "FindClose" int
#cfunc _GetFileSizeEx    "GetFileSize" int, var
#cfunc _CreateFileA      "CreateFileA" str, int, int, int, int, int, int
#cfunc _CloseHandle3     "CloseHandle" int
#cfunc _SetFileTime2     "SetFileTime" int, int, int, var
#cfunc _GetSystemTimeAsFileTime "GetSystemTimeAsFileTime" var

; FILE_ATTRIBUTE constants
#define _ATTR_READONLY  0x01
#define _ATTR_HIDDEN    0x02
#define _ATTR_DIRECTORY 0x10
#define _ATTR_ARCHIVE   0x20
#define _ATTR_INVALID   0xFFFFFFFF

;------------------------------------------------------------
; File operations
;------------------------------------------------------------

#deffunc fs_copy str src, str dst
	if _CopyFileA(src, dst, 0) == 0 : return -1
	return 0

#deffunc fs_move str src, str dst
	if _MoveFileA(src, dst) == 0 : return -1
	return 0

#deffunc fs_rename str oldname, str newname
	if _MoveFileA(oldname, newname) == 0 : return -1
	return 0

#defcfunc fs_size str path, local _h, local _hi
	_h = _CreateFileA(path, 0x80000000, 1, 0, 3, 0, 0)
	if _h == -1 : return -1
	_hi = 0
	sz = _GetFileSizeEx(_h, _hi)
	_r = _CloseHandle3(_h)
	return sz

#defcfunc fs_attr str path
	return _GetFileAttributesA(path)

#defcfunc fs_is_readonly str path, local _a
	_a = _GetFileAttributesA(path)
	if _a == _ATTR_INVALID : return 0
	return (_a & _ATTR_READONLY) != 0

#defcfunc fs_is_hidden str path, local _a
	_a = _GetFileAttributesA(path)
	if _a == _ATTR_INVALID : return 0
	return (_a & _ATTR_HIDDEN) != 0

#defcfunc fs_is_dir str path, local _a
	_a = _GetFileAttributesA(path)
	if _a == _ATTR_INVALID : return 0
	return (_a & _ATTR_DIRECTORY) != 0

#defcfunc fs_is_file str path, local _a
	_a = _GetFileAttributesA(path)
	if _a == _ATTR_INVALID : return 0
	if (_a & _ATTR_DIRECTORY) != 0 : return 0
	return 1

#deffunc fs_set_readonly str path, int sw, local _a
	_a = _GetFileAttributesA(path)
	if _a == _ATTR_INVALID : return -1
	if sw {
		_a = _a | _ATTR_READONLY
	} else {
		_a = _a & (_ATTR_READONLY ^ 0xFFFFFFFF)
	}
	_r = _SetFileAttributesA(path, _a)
	return 0

#deffunc fs_touch str path, local _h, local _ft
	; Create or open existing
	_h = _CreateFileA(path, 0x40000000, 0, 0, 4, 0, 0)
	if _h == -1 : return -1
	; Update modification time to now
	sdim _ft, 8
	_r = _GetSystemTimeAsFileTime(_ft)
	_r = _SetFileTime2(_h, 0, 0, _ft)
	_r = _CloseHandle3(_h)
	return 0

#defcfunc fs_readtext str path, local _rbuf, local _rsz
	exist path
	_rsz = strsize
	if _rsz <= 0 : return ""
	sdim _rbuf, _rsz + 1
	bload path, _rbuf, _rsz
	return _rbuf

#deffunc fs_writetext str path, str text, local _wt
	_wt = text
	notesel _wt
	notesave path
	return

#deffunc fs_appendtext str path, str text, local existing, local combined
	existing = fs_readtext(path)
	combined = existing + text
	notesel combined
	notesave path
	return

#defcfunc fs_tempfile local _tmpdir, local _tmpfile, local _tr
	sdim _tmpdir, 260
	_tr = _GetTempPathA2(260, _tmpdir)
	sdim _tmpfile, 260
	_tr = _GetTempFileNameA(_tmpdir, "hsp", 0, _tmpfile)
	return _tmpfile

#defcfunc fs_ext str path
	return getpath(path, 2)

#defcfunc fs_basename str path
	return getpath(path, 8)

#defcfunc fs_dirname str path
	return getpath(path, 32)

; Check if file is locked (in use by another process)
#defcfunc fs_is_locked str path, local _lh
	; Try to open with exclusive access
	_lh = _CreateFileA(path, 0xC0000000, 0, 0, 3, 0, 0)
	if _lh == -1 : return 1  ; locked
	_r = _CloseHandle3(_lh)
	return 0  ; not locked

;------------------------------------------------------------
; Folder operations
;------------------------------------------------------------

; mkdir -p (recursive)
#deffunc fs_mkdir_p str path, local parts, local built, local i, local seg
	built = ""
	parts = path
	strrep parts, "/", "\\"
	repeat
		i = instr(parts, 0, "\\")
		if i < 0 {
			seg = parts
		} else {
			seg = strmid(parts, 0, i)
			parts = strmid(parts, i + 1, 4096)
		}
		if built != "" : built += "\\"
		built += seg
		; Skip drive letter (C:)
		if strlen(built) > 2 {
			_r = _CreateDirectoryA(built, 0)
		}
		if i < 0 : break
	loop
	return 0

; List files in directory
#deffunc fs_listfiles str dir, str pattern, local _fd, local _hf, local _res, local _fn, local fpath
	sdim _fd, 592
	if pattern == "" {
		fpath = dir + "\\*"
	} else {
		fpath = dir + "\\" + pattern
	}
	_hf = _FindFirstFileA(fpath, _fd)
	if _hf == -1 : return ""
	_res = ""
	repeat
		sdim _fn, 260
		memcpy _fn, _fd, 260, 0, 44
		; Skip . and ..
		if _fn != "." {
			if _fn != ".." {
				; Check if file (not directory)
				_a = lpeek(_fd, 0)
				if (_a & _ATTR_DIRECTORY) == 0 {
					if _res != "" : _res += "\n"
					_res += _fn
				}
			}
		}
		sdim _fd, 592
		if _FindNextFileA(_hf, _fd) == 0 : break
	loop
	_r = _FindClose2(_hf)
	return _res

; List subdirectories
#deffunc fs_listdirs str dir, local _fd2, local _hf2, local _res2, local _fn2, local _a2
	sdim _fd2, 592
	_hf2 = _FindFirstFileA(dir + "\\*", _fd2)
	if _hf2 == -1 : return ""
	_res2 = ""
	repeat
		sdim _fn2, 260
		memcpy _fn2, _fd2, 260, 0, 44
		if _fn2 != "." {
			if _fn2 != ".." {
				_a2 = lpeek(_fd2, 0)
				if (_a2 & _ATTR_DIRECTORY) != 0 {
					if _res2 != "" : _res2 += "\n"
					_res += _fn
				}
			}
		}
		sdim _fd2, 592
		if _FindNextFileA(_hf, _fd2) == 0 : break
	loop
	_r = _FindClose2(_hf2)
	return _res2

; Remove directory recursively
#deffunc fs_rmdir_r str path, local files, local dirs, local f
	; Delete files first
	fs_listfiles path, "*"
	files = refstr
	notesel files
	repeat notemax
		noteget f, cnt
		if f != "" : _r = _DeleteFileA(path) + "\\" + f
	loop
	; Recurse into subdirs
	fs_listdirs path
	dirs = refstr
	notesel dirs
	repeat notemax
		noteget f, cnt
		if f != "" : fs_rmdir_r path + "\\" + f
	loop
	_r = _RemoveDirectoryA(path)
	return

#global
#endif
