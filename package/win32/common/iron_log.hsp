;
; iron_logger.hsp - Log output module
;
#ifndef __iron_logger_hsp__
#define __iron_logger_hsp__
#include "iron_datetime.hsp"

#define global LOG_DEBUG 0
#define global LOG_INFO  1
#define global LOG_WARN  2
#define global LOG_ERROR 3

#module iron_logger

#deffunc ilog_init str filepath, int level
	_log_file = filepath
	_log_level = level
	_log_console = 1
	return

#deffunc ilog_set_level int level
	_log_level = level
	return

#deffunc ilog_write int level, str msg, local ts, local lv, local _line
	if level < _log_level : return
	ts = datetime_now()
	if level == 0 : lv = "DEBUG"
	if level == 1 : lv = "INFO "
	if level == 2 : lv = "WARN "
	if level == 3 : lv = "ERROR"
	_line = "[" + ts + "] " + lv + " " + msg
	if _log_console : mes _line
	return

#deffunc ilog_debug str msg
	ilog_write 0, msg
	return

#deffunc ilog_info str msg
	ilog_write 1, msg
	return

#deffunc ilog_warn str msg
	ilog_write 2, msg
	return

#deffunc ilog_error str msg
	ilog_write 3, msg
	return

#global

#endif
