;============================================================
;   iron_regex_net.hsp - 正規表現 (.NET版)
;
;   System.Text.RegularExpressions.Regex を使用。
;   hsp3net 専用。名前付きグループ等 .NET regex の全機能が使える。
;
;   API:
;     netregex_match pattern, text       全体マッチ → stat (1/0)
;     netregex_search pattern, text      最初のマッチ → refstr
;     netregex_replace pattern, text, rep 全置換 → refstr
;     netregex_count(pattern, text)      マッチ数
;     netregex_split pattern, text       分割 → refstr (改行区切り)
;
;   例:
;     #include "iron_regex_net.hsp"
;     netregex_search "\d+", "abc123def"
;     mes refstr  ; "123"
;============================================================
#ifndef __iron_regex_net_hsp__
#define __iron_regex_net_hsp__

#module iron_regex_net

#deffunc netregex_match str pattern, str text, \
	local pRegex, local pMatch
	newnet pRegex, "", "System.Text.RegularExpressions.Regex", 0, pattern
	netres pMatch
	mcall pRegex, "IsMatch", text
	return nettoval(pMatch, 4)

#deffunc netregex_search str pattern, str text, \
	local pRegex, local pMatch, local pVal
	newnet pRegex, "", "System.Text.RegularExpressions.Regex", 0, pattern
	netres pMatch
	mcall pRegex, "Match", text
	netres pVal
	mcall pMatch, "get_Success"
	if nettoval(pVal, 4) == 0 {
		delnet pMatch : delnet pRegex
		return ""
	}
	netres pVal
	mcall pMatch, "get_Value"
	s = nettoval(pVal, 2)
	delnet pMatch : delnet pRegex
	return s

#deffunc netregex_replace str pattern, str text, str rep, \
	local pResult
	; Static method call
	newnet pRegex, "", "System.Text.RegularExpressions.Regex", 1
	netres pResult
	mcall pRegex, "Replace", text, pattern, rep
	s = nettoval(pResult, 2)
	delnet pRegex
	return s

#defcfunc netregex_count str pattern, str text, \
	local pRegex, local pMatches, local pCount
	newnet pRegex, "", "System.Text.RegularExpressions.Regex", 0, pattern
	netres pMatches
	mcall pRegex, "Matches", text
	netres pCount
	mcall pMatches, "get_Count"
	n = nettoval(pCount, 4)
	delnet pMatches : delnet pRegex
	return n

#deffunc netregex_split str pattern, str text, \
	local pRegex, local pArr, local pLen, local pItem, local result
	newnet pRegex, "", "System.Text.RegularExpressions.Regex", 0, pattern
	netres pArr
	mcall pRegex, "Split", text
	netres pLen
	mcall pArr, "get_Length"
	n = nettoval(pLen, 4)
	result = ""
	repeat n
		netres pItem
		mcall pArr, "GetValue", cnt
		if result != "" : result += "\n"
		result += nettoval(pItem, 2)
	loop
	delnet pArr : delnet pRegex
	return result

#global
#endif
