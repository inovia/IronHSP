#deffunc iron_uia_text_range int h, var v_text, local _hh, local _r
	sdim v_text, 65536
	_uia_load_cs
	newnet _hh, "HspUia"
	mcall _hh, "TextAll", _r, h
	v_text = "" + _r
	return 0

