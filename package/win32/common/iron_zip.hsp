;============================================================
;   iron_zip.hsp — ZIP アーカイブ読み書き (miniz wrapper)
;
;   hspzip.dll をラップした ZIP 読み書きモジュール。
;   第三者依存なしの miniz (public domain) を埋め込み。
;
;   API:
;     h = zip_open_read(path)        ZIP 読み込み open
;     h = zip_open_write(path)       ZIP 新規作成 open
;     n = zip_count(h)                エントリ数
;     zip_entry_name h, idx, name_var
;     sz = zip_entry_size(h, idx)
;     zip_extract_file h, idx, out_path
;     zip_extract_mem h, idx, buf_var, max_bytes
;     zip_add_file h, "entry.txt", "src.txt"
;     zip_add_mem h, "entry.txt", buf_var, len
;     zip_close h
;
;   例: zip ファイル読み込み + 全展開
;     #include "iron_zip.hsp"
;         h = zip_open_read("sample.zip")
;         n = zip_count(h)
;         repeat n
;             zip_entry_name h, cnt, name
;             zip_extract_file h, cnt, "extracted/" + name
;         loop
;         zip_close h
;============================================================

#ifndef __iron_zip_hsp__
#define __iron_zip_hsp__

#uselib "hspzip.dll"
#cfunc zip_open_read    "zip_open_read"    str
#cfunc zip_open_write   "zip_open_write"   str
#cfunc zip_count        "zip_count"        int
#func  zip_entry_name_  "zip_entry_name"   int, int, var, int
#cfunc zip_entry_size   "zip_entry_size"   int, int
#cfunc zip_extract_file "zip_extract_file" int, int, str
#cfunc zip_extract_mem_ "zip_extract_mem"  int, int, var, int
#cfunc zip_add_file     "zip_add_file"     int, str, str
#cfunc zip_add_mem_     "zip_add_mem"      int, str, var, int
#func  zip_close        "zip_close"        int

;   文字列変数にエントリ名を書き込む (wrapper)
#deffunc zip_entry_name int h, int idx, var out_name
    sdim out_name, 1024
    zip_entry_name_ h, idx, out_name, 1023
    return

;   バッファにエントリ内容を書き込む (wrapper, 戻り値はサイズ)
#defcfunc zip_extract_mem int h, int idx, var buf, int max_bytes
    return zip_extract_mem_(h, idx, buf, max_bytes)

;   バッファをエントリとして追加 (wrapper)
#defcfunc zip_add_mem int h, str entry_name, var buf, int len
    return zip_add_mem_(h, entry_name, buf, len)

#endif
