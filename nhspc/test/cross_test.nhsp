#assembly "CrossTest"

#class public Point
  #field public int X
  #field public int Y
  #init int x, int y
    X = x
    Y = y
  #endinit
  #func public int Sum
    return X + Y
  #endfunc
#endclass

#class public Factory
  #func public static int MakeAndSum
    new p, Point(10, 20)
    return p.Sum()
  #endfunc
#endclass
