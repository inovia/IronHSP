{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "NHSP Debug (.NET Framework)",
            "type": "clr",
            "request": "launch",
            "program": "${workspaceFolder}/${fileBasenameNoExtension}.exe",
            "cwd": "${workspaceFolder}",
            "stopAtEntry": false
        },
        {
            "name": "NHSP Debug (coreclr fallback)",
            "type": "coreclr",
            "request": "launch",
            "program": "${workspaceFolder}/${fileBasenameNoExtension}.exe",
            "cwd": "${workspaceFolder}",
            "stopAtEntry": false
        }
    ]
}
