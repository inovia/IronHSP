; 19: デリゲート
#assembly "Delegate"

#delegate public int BinaryOp, int a, int b
#delegate public void Logger, string message
#delegate public bool Predicate, int value

#class public Calculator
  #func public static int Apply, BinaryOp op, int x, int y
    return op.Invoke(x, y)
  #endfunc

  #func public static int Add, int a, int b
    return a + b
  #endfunc

  #func public static int Multiply, int a, int b
    return a * b
  #endfunc
#endclass
