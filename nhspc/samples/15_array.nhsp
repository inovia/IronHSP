; 15: 配列 — 宣言、アクセス、ループ
#assembly "Array", exe

#class public App
  #func public static void Run
    ; int 配列
    dim int[] nums, 5
    for i = 0 to 4
      nums(i) = i * i
    next

    print "--- squares ---"
    for i = 0 to 4
      print str(i) + " * " + str(i) + " = " + str(nums(i))
    next
  #endfunc
#endclass

#main
  App.Run()
#endmain
