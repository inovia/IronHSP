; 07: ループ — repeat, for, while, foreach
#assembly "Loops", exe

#main
  ; repeat (HSP 形式)
  print "--- repeat ---"
  repeat 5
    print $"cnt = {str(cnt)}"
  loop

  ; for / next
  print "--- for ---"
  for i = 1 to 5
    print $"i = {str(i)}"
  next

  ; for with step
  print "--- for step ---"
  for i = 0 to 10 step 2
    print $"i = {str(i)}"
  next

  ; while / wend
  print "--- while ---"
  int x = 0
  while x < 5
    print $"x = {str(x)}"
    x++
  wend

  ; break / continue
  print "--- break ---"
  repeat 10
    if cnt = 3
      continue
    endif
    if cnt = 7
      break
    endif
    print $"cnt = {str(cnt)}"
  loop
#endmain
