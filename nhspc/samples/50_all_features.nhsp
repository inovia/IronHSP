; 50: 全機能デモ — なるべく多くの文法を1ファイルに
#assembly "AllFeatures", exe

; 列挙型
#enum Direction
  North
  South = 10
  East
  West
#endenum

; デリゲート
#delegate public int Transform, int value

; インターフェース
#interface IDescribable
  #func string Describe
#endinterface

; 構造体
#struct public Point, Sequential
  #field public int X
  #field public int Y
#endstruct

; sealed + インターフェース
#class public sealed Car : IDescribable
  #field public string Name
  #field public string Maker
  #field private int _speed
  #field public const int MAX_SPEED = 200

  #init string name, string maker, int speed
    Name = name
    Maker = maker
    _speed = speed
  #endinit

  #func public string Describe
    return Name + " by " + Maker + " (" + str(_speed) + "km/h)"
  #endfunc

  #func public int GetSpeed
    return _speed
  #endfunc

  #event public EventHandler Started
#endclass

; P/Invoke
#class public NativeHelper
  #dllimport "kernel32.dll"
  #dllfunc public static int GetTickCount
#endclass

; メインロジック
#class public App
  #func public static void Run
    ; 変数宣言 (dim省略形 + コロン区切り)
    int x = 10 : int y = 20 : string msg = "NHSP"

    ; 三項演算子 + null合体
    string result = x > 5 ? "big" : "small"
    string safe = null ?? "default"

    ; ビット演算
    int bits = (x & $0F) | ($F0) : bits = bits ^ $FF

    ; 出力
    print "=== " + msg + " All Features Demo ==="
    print "x=" + str(x) + ", y=" + str(y)
    print "ternary=" + result + ", null_coal=" + safe
    print "bits=" + str(bits)

    ; ループ
    print "--- repeat ---"
    repeat 3
      print "  cnt=" + str(cnt)
    loop

    ; for
    print "--- for ---"
    for i = 0 to 2
      print "  i=" + str(i)
    next

    ; switch
    switch x
      case 10
        print "x is 10"
      default
        print "x is other"
    endswitch

    ; try/catch
    try
      int z = x / y
      print "x/y = " + str(z)
    catch Exception e
      print "Error: " + e.Message
    #endtry

    ; Car クラス
    Car car = new Car("Roadster", "NHSP Motors", 150)
    print car.Describe()
    print "Speed: " + str(car.GetSpeed()) + " km/h"

    ; .NET API
    print "Machine: " + Environment.MachineName

    print "=== Done ==="
  #endfunc
#endclass

#main
  App.Run()
#endmain
