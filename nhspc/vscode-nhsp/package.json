{
  "name": "nhsp-language",
  "displayName": "NHSP Language Support",
  "description": "Syntax highlighting, compile, and debug support for NHSP (.nhsp) - HSP-style .NET compiler",
  "version": "0.1.0",
  "publisher": "ironhsp",
  "engines": {
    "vscode": "^1.93.0"
  },
  "categories": [
    "Programming Languages",
    "Snippets",
    "Debuggers",
    "Chat"
  ],
  "activationEvents": [
    "onLanguage:nhsp"
  ],
  "main": "./src/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "nhsp",
        "aliases": ["NHSP", "nhsp", "Net HSP"],
        "extensions": [".nhsp"],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "nhsp",
        "scopeName": "source.nhsp",
        "path": "./syntaxes/nhsp.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "nhsp",
        "path": "./snippets/nhsp.json"
      }
    ],
    "languageModelTools": [
      {
        "name": "nhsp-spec",
        "displayName": "NHSP Language Specification",
        "description": "Look up NHSP (Net HSP) language syntax, directives, types, control flow, operators, and built-in functions. NHSP is a custom language with HSP-like syntax that compiles to .NET assemblies. Use this tool when the user asks about NHSP syntax or wants to write NHSP code.",
        "canBeReferencedInPrompt": true,
        "inputSchema": {
          "type": "object",
          "properties": {
            "topic": {
              "type": "string",
              "description": "Topic to look up: 'all', 'directives', 'types', 'control', 'operators', 'builtins', or 'overview'",
              "enum": ["all", "overview", "directives", "types", "control", "operators", "builtins"]
            }
          }
        }
      },
      {
        "name": "nhsp-convert",
        "displayName": "C# to NHSP Conversion Rules",
        "description": "Get the rules for converting C# code to NHSP syntax. Use this when the user wants to convert C# code to NHSP or needs to understand the mapping between C# and NHSP constructs.",
        "canBeReferencedInPrompt": true,
        "inputSchema": {
          "type": "object",
          "properties": {}
        }
      },
      {
        "name": "nhsp-current-file",
        "displayName": "Current NHSP File",
        "description": "Get the contents and structure of the currently open NHSP file, including class names, method names, and field names.",
        "canBeReferencedInPrompt": true,
        "inputSchema": {
          "type": "object",
          "properties": {}
        }
      }
    ],
    "chatParticipants": [
      {
        "id": "nhsp.chat",
        "fullName": "NHSP Language Assistant",
        "name": "nhsp",
        "description": "NHSP (HSP風 .NET言語) のコーディング支援。文法の質問、C#からの変換、コード生成に対応。",
        "isSticky": true,
        "commands": [
          {
            "name": "convert",
            "description": "C# コードを NHSP に変換"
          },
          {
            "name": "explain",
            "description": "NHSP コードの説明"
          },
          {
            "name": "spec",
            "description": "NHSP の言語仕様を表示"
          }
        ]
      }
    ],
    "commands": [
      {
        "command": "nhsp.compile",
        "title": "NHSP: Compile",
        "icon": "$(play)"
      },
      {
        "command": "nhsp.compileDll",
        "title": "NHSP: Compile as DLL"
      },
      {
        "command": "nhsp.compileDebug",
        "title": "NHSP: Compile with Debug Info"
      },
      {
        "command": "nhsp.compileDebugDll",
        "title": "NHSP: Compile as DLL with Debug Info"
      },
      {
        "command": "nhsp.run",
        "title": "NHSP: Compile & Run"
      },
      {
        "command": "nhsp.debug",
        "title": "NHSP: Debug (Compile & Launch Debugger)",
        "icon": "$(debug-alt)"
      }
    ],
    "breakpoints": [
      { "language": "nhsp" }
    ],
    "debuggers": [
      {
        "type": "nhsp",
        "label": "NHSP Debug",
        "languages": ["nhsp"],
        "configurationAttributes": {
          "launch": {
            "required": ["program"],
            "properties": {
              "program": {
                "type": "string",
                "description": "Path to the compiled EXE"
              },
              "sourceFile": {
                "type": "string",
                "description": "Path to the .nhsp source file"
              }
            }
          }
        },
        "configurationSnippets": [
          {
            "label": "NHSP: Launch",
            "description": "Compile and debug NHSP program",
            "body": {
              "type": "clr",
              "request": "launch",
              "name": "NHSP Debug",
              "program": "^\"\\${workspaceFolder}/${1:program}.exe\"",
              "cwd": "^\"\\${workspaceFolder}\""
            }
          }
        ]
      }
    ],
    "menus": {
      "editor/title/run": [
        {
          "command": "nhsp.compile",
          "group": "1_nhsp@1",
          "when": "resourceLangId == nhsp"
        },
        {
          "command": "nhsp.run",
          "group": "1_nhsp@2",
          "when": "resourceLangId == nhsp"
        },
        {
          "command": "nhsp.debug",
          "group": "1_nhsp@3",
          "when": "resourceLangId == nhsp"
        }
      ],
      "editor/title": [
        {
          "command": "nhsp.compile",
          "group": "navigation",
          "when": "resourceLangId == nhsp"
        }
      ],
      "editor/context": [
        {
          "command": "nhsp.compile",
          "group": "1_nhsp@1",
          "when": "resourceLangId == nhsp"
        },
        {
          "command": "nhsp.compileDll",
          "group": "1_nhsp@2",
          "when": "resourceLangId == nhsp"
        },
        {
          "command": "nhsp.run",
          "group": "1_nhsp@3",
          "when": "resourceLangId == nhsp"
        }
      ]
    },
    "keybindings": [
      {
        "command": "nhsp.compile",
        "key": "f5",
        "when": "resourceLangId == nhsp && !inDebugMode"
      },
      {
        "command": "-workbench.action.debug.start",
        "key": "f5",
        "when": "resourceLangId == nhsp"
      },
      {
        "command": "nhsp.compileDebug",
        "key": "ctrl+f5",
        "when": "resourceLangId == nhsp && !inDebugMode"
      },
      {
        "command": "-workbench.action.debug.run",
        "key": "ctrl+f5",
        "when": "resourceLangId == nhsp"
      },
      {
        "command": "nhsp.run",
        "key": "f6",
        "when": "resourceLangId == nhsp"
      }
    ],
    "configuration": {
      "title": "NHSP",
      "properties": {
        "nhsp.compilerPath": {
          "type": "string",
          "default": "",
          "description": "Path to nhspc.exe compiler. Leave empty to auto-detect."
        },
        "nhsp.outputDirectory": {
          "type": "string",
          "default": "",
          "description": "Output directory for compiled files. Leave empty for same directory as source."
        }
      }
    },
    "problemMatchers": [
      {
        "name": "nhsp",
        "owner": "nhsp",
        "fileLocation": ["relative", "${workspaceFolder}"],
        "pattern": {
          "regexp": "^\\((\\d+),(\\d+)\\): (error|warning): (.*)$",
          "line": 1,
          "column": 2,
          "severity": 3,
          "message": 4
        }
      }
    ]
  }
}
