;
; DxLib サンプル06: アニメーション
; フレームカウンタによる簡易アニメーション
;

#include "hspdxlib.as"
#include "hspdxlib_macro.as"

	ChangeWindowMode TRUE
	SetGraphMode 640, 480, 32
	SetMainWindowText "DxLib アニメーションサンプル"

	if DxLib_Init() == -1 : end
	SetDrawScreen DX_SCREEN_BACK

	white  = GetColor(255, 255, 255)
	yellow = GetColor(255, 255, 0)

	; ボール
	bx = 100.0
	by = 200.0
	bvx = 3.0
	bvy = -5.0
	gravity = 0.2

	; 星
	dim star_x, 20
	dim star_y, 20
	dim star_speed, 20
	repeat 20
		star_x(cnt) = rnd(640)
		star_y(cnt) = rnd(480)
		star_speed(cnt) = rnd(3) + 1
	loop

	frame = 0

*main
	ClearDrawScreen_1

	; 背景の星を流す
	repeat 20
		star_y(cnt) += star_speed(cnt)
		if star_y(cnt) > 480 {
			star_y(cnt) = 0
			star_x(cnt) = rnd(640)
		}
		c = GetColor(star_speed(cnt) * 80, star_speed(cnt) * 80, 255)
		DrawPixel star_x(cnt), star_y(cnt), c
	loop

	; バウンドするボール
	bx += bvx
	by += bvy
	bvy += gravity

	; 壁反射
	if bx < 10 : bx = 10.0 : bvx = 0.0 - bvx
	if bx > 620 : bx = 620.0 : bvx = 0.0 - bvx
	if by > 460 {
		by = 460.0
		bvy = 0.0 - bvy * 0.9
	}
	if by < 10 : by = 10.0 : bvy = 0.0 - bvy

	; ボール描画 (色変化アニメーション)
	r = 128 + sin(frame * 0.05) * 127
	g = 128 + sin(frame * 0.07 + 2.0) * 127
	b = 128 + sin(frame * 0.09 + 4.0) * 127
	ball_color = GetColor(int(r), int(g), int(b))
	DrawCircle int(bx), int(by), 15, ball_color, TRUE

	; 回転する四角形 (簡易)
	cx = 320
	cy = 240
	sz = 40
	a = frame * 0.03
	; 4頂点を計算して三角形2つで描画
	x1 = cx + int(cos(a) * sz - sin(a) * sz)
	y1 = cy + int(sin(a) * sz + cos(a) * sz)
	x2 = cx + int(cos(a) * sz * -1 - sin(a) * sz)
	y2 = cy + int(sin(a) * sz * -1 + cos(a) * sz)
	x3 = cx + int(cos(a) * sz * -1 - sin(a) * sz * -1)
	y3 = cy + int(sin(a) * sz * -1 + cos(a) * sz * -1)
	x4 = cx + int(cos(a) * sz - sin(a) * sz * -1)
	y4 = cy + int(sin(a) * sz + cos(a) * sz * -1)
	DrawTriangle x1, y1, x2, y2, x3, y3, yellow, TRUE
	DrawTriangle x1, y1, x3, y3, x4, y4, yellow, TRUE

	; FPS表示
	DrawFormatString 10, 10, white, "Frame: %d", frame

	frame += 1

	ScreenFlip

	if ProcessMessage() != 0 : goto *quit
	if CheckHitKey(KEY_INPUT_ESCAPE) == 1 : goto *quit
	goto *main

*quit
	DxLib_End
	end
