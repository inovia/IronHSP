;
; DxLib サンプル07: フォント描画
; フォントハンドルの作�?�と�?字描画
;

#include "hspdxlib.as"
#include "hspdxlib_macro.as"

	ChangeWindowMode TRUE
	SetGraphMode 800, 600, 32
	SetMainWindowText "DxLib フォントサンプル"

	if DxLib_Init() == -1 : end
	SetDrawScreen DX_SCREEN_BACK

	white  = GetColor(255, 255, 255)
	red    = GetColor(255, 0, 0)
	green  = GetColor(0, 255, 0)
	yellow = GetColor(255, 255, 0)
	cyan   = GetColor(0, 255, 255)
	gray   = GetColor(128, 128, 128)

	; フォントハンドル作�??
	font_big   = CreateFontToHandle("メイリオ", 32, -1)
	font_small = CreateFontToHandle("?��?�� ゴシ�?ク", 14, -1)
	font_edge  = CreateFontToHandle("メイリオ", 24, -1, DX_FONTTYPE_ANTIALIASING_EDGE)

*main
	ClearDrawScreen_1

	; �?フォルトフォントで描画
	DrawString 20, 20, "�?フォルトフォン�? (DrawString)", white

	; フォントサイズ変更
	SetFontSize 24
	DrawString 20, 50, "フォントサイズ 24", yellow
	SetFontSize 16  ; 戻�?

	; フォントハンドルを使って描画
	if font_big != -1 {
		DrawStringToHandle 20, 100, "大きいフォン�? (メイリオ 32pt)", green, font_big
	}

	if font_small != -1 {
		DrawStringToHandle 20, 150, "小さ�?フォン�? (MS ゴシ�?ク 14pt)", cyan, font_small
	}

	if font_edge != -1 {
		DrawStringToHandle 20, 180, "縁取りフォン�? (AA+Edge)", red, font_edge
	}

	; 書式付き�?字�??
	DrawString 20, 240, strf("整数: %d  小数: %.2f  �?字�??: %s", 42, 3.14, "Hello"), white

	; �?字�?��?�描画�?を取得して右�?�?
	msg = "右�?せテキス�?"
	w = GetDrawStringWidth(msg, strlen(msg))
	DrawString 800 - w - 20, 300, msg, yellow

	; �?数行テキス�?
	DrawString 20, 350, "�?1: HSPからDxLibを使�?", white
	DrawString 20, 370, "�?2: Unicode�?字�?�対�? (DxLibW)", white
	DrawString 20, 390, "�?3: フォントハンドルで自由なフォン�?", white
	DrawString 20, 410, "�?4: 縁取り�?�アンチエイリアス対�?", white

	; 色付き�?キス�?
	DrawString 20, 460, "赤", red
	DrawString 60, 460, "�?", green
	DrawString 100, 460, "�?", GetColor(0, 100, 255)
	DrawString 140, 460, "�?", yellow

	DrawString 20, 560, "ESCキーで終�?", gray

	ScreenFlip

	if ProcessMessage() != 0 : goto *quit
	if CheckHitKey(KEY_INPUT_ESCAPE) == 1 : goto *quit
	goto *main

*quit
	if font_big != -1 : DeleteFontToHandle font_big
	if font_small != -1 : DeleteFontToHandle font_small
	if font_edge != -1 : DeleteFontToHandle font_edge
	DxLib_End
	end
