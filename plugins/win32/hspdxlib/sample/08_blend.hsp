;
; DxLib サンプル08: ブレンドモード
; 各種ブレンドモードのデモ
;

#include "hspdxlib.as"
#include "hspdxlib_macro.as"

	ChangeWindowMode TRUE
	SetGraphMode 800, 600, 32
	SetMainWindowText "DxLib ブレンドモードサンプル"

	if DxLib_Init() == -1 : end
	SetDrawScreen DX_SCREEN_BACK

	white  = GetColor(255, 255, 255)
	red    = GetColor(255, 0, 0)
	green  = GetColor(0, 255, 0)
	blue   = GetColor(0, 0, 255)

	alpha = 128
	mode = 0

*main
	ClearDrawScreen_1

	; 背景パターン (市松模様)
	repeat 20
		y_idx = cnt
		repeat 25
			x_idx = cnt
			if (x_idx + y_idx) \ 2 == 0 {
				c = GetColor(60, 60, 60)
			} else {
				c = GetColor(40, 40, 40)
			}
			DrawBox x_idx * 32, y_idx * 30, x_idx * 32 + 32, y_idx * 30 + 30, c, TRUE
		loop
	loop

	; ベース図形
	DrawCircle 300, 300, 120, red, TRUE
	DrawCircle 400, 250, 120, green, TRUE
	DrawCircle 500, 300, 120, blue, TRUE

	; ブレンドモード選択
	if CheckHitKey(KEY_INPUT_1) == 1 : mode = DX_BLENDMODE_NOBLEND
	if CheckHitKey(KEY_INPUT_2) == 1 : mode = DX_BLENDMODE_ALPHA
	if CheckHitKey(KEY_INPUT_3) == 1 : mode = DX_BLENDMODE_ADD
	if CheckHitKey(KEY_INPUT_4) == 1 : mode = DX_BLENDMODE_SUB
	if CheckHitKey(KEY_INPUT_5) == 1 : mode = DX_BLENDMODE_MUL

	; アルファ値調整
	if CheckHitKey(KEY_INPUT_UP) == 1 : alpha += 2
	if CheckHitKey(KEY_INPUT_DOWN) == 1 : alpha -= 2
	if alpha < 0 : alpha = 0
	if alpha > 255 : alpha = 255

	; ブレンド適用して白い矩形を描画
	SetDrawBlendMode mode, alpha
	DrawBox 200, 150, 600, 450, white, TRUE
	SetDrawBlendMode DX_BLENDMODE_NOBLEND, 0

	; 操作説明
	DrawString 10, 10, "[1]NoBlend [2]Alpha [3]Add [4]Sub [5]Mul", white
	DrawFormatString 10, 30, white, "Alpha: %d (↑/↓で変更)", alpha

	mname = "NOBLEND"
	if mode == DX_BLENDMODE_ALPHA : mname = "ALPHA"
	if mode == DX_BLENDMODE_ADD : mname = "ADD"
	if mode == DX_BLENDMODE_SUB : mname = "SUB"
	if mode == DX_BLENDMODE_MUL : mname = "MUL"
	DrawFormatString 10, 50, white, "Mode: %s", mname

	DrawString 10, 570, "ESCキーで終了", white

	ScreenFlip

	if ProcessMessage() != 0 : goto *quit
	if CheckHitKey(KEY_INPUT_ESCAPE) == 1 : goto *quit
	WaitTimer 16
	goto *main

*quit
	DxLib_End
	end
