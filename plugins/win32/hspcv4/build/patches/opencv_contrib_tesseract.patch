--- a/modules/text/cmake/init.cmake
+++ b/modules/text/cmake/init.cmake
@@ -4,6 +4,14 @@ OCV_OPTION(WITH_TESSERACT "Include Tesseract OCR library support" (NOT CMAKE_CRO
 if(NOT HAVE_TESSERACT
     AND (WITH_TESSERACT OR OPENCV_FIND_TESSERACT)
 )
+  # hspcv4 patch: allow direct cmake -D injection of Tesseract_* vars (avoids
+  # the pkg-config probe + try_compile check, which both fail on Windows
+  # without pkgconf in PATH and a C++17-aware test compile).
+  if(NOT Tesseract_FOUND AND HSPCV4_TESSERACT_LIB AND HSPCV4_TESSERACT_INC)
+    set(Tesseract_FOUND TRUE)
+    set(Tesseract_VERSION "vcpkg")
+    set(Tesseract_LIBRARIES "${HSPCV4_TESSERACT_LIB}" "${HSPCV4_LEPTONICA_LIB}")
+    set(Tesseract_INCLUDE_DIRS "${HSPCV4_TESSERACT_INC}")
+    set(OPENCV_SKIP_TESSERACT_BUILD_CHECK TRUE)
+    message(STATUS "Tesseract: HSPCV4 vcpkg override -> ${Tesseract_LIBRARIES}")
+  endif()
   if(NOT Tesseract_FOUND)
     find_package(Tesseract QUIET)  # Prefer CMake's standard locations (including Tesseract_DIR)
   endif()
