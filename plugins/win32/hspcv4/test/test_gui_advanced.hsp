;
;  hspcv4 advanced GUI test : cv4_show / cv4_wait_key
;
;  cv::pollKey + HSP 協調メッセージ処理が壊れていないかを確認する。
;  Phase 1 で cv::waitKey が HSP と競合して Error 38 を起こした問題の再検証。
;
#include "hspcv4.as"

    title "hspcv4 advanced GUI test"
    screen 0, 640, 480
    cls 4
    pos 10, 10
    color 0, 0, 0
    mes "hspcv4 advanced GUI test"
    mes "  1. Loading image..."
    redraw 1

    cv4load 0, "test_image.png"
    if stat : dialog "cv4load failed" : end

    ; リサイズして描画込みの画像を作る
    cv4resize 1, 0, 400, 300
    cv4rect   1, 10, 10, 100, 60, 0, 255, 0, 3
    cv4circle 1, 300, 150, 40, 0, 0, 255, -1
    cv4text   1, "hspcv4 test", 120, 280, 1.0, 255, 255, 0, 2

    ; OpenCV ウィンドウで表示
    cv4_show 1, "hspcv4 window"
    pos 10, 40
    mes "  2. OpenCV window opened. Press any key (5 sec timeout)..."
    redraw 1

    ; 5 秒タイムアウトでキー待ち (var_key に格納)
    cv4_wait_key key, 5000
    pos 10, 70
    if stat {
        mes "  3. timeout — OK if you did not press a key"
    } else {
        mes "  3. key pressed: " + key + " (success)"
    }
    redraw 1

    ; 追記描画: 押したキーコードを画像にテキストで描き込む
    cv4text 1, "key=" + key, 20, 50, 1.2, 0, 0, 255, 2
    cv4_show 1, "hspcv4 window"
    cv4_wait_key dummy, 1500

    ; ウィンドウを閉じる
    cv4_close_window "hspcv4 window"

    ; cv4putimg が crash しないこと (Phase 1 で cv::waitKey 後にクラッシュ
    ; していた箇所の回帰テスト)
    pos 10, 100
    mes "  4. Testing cv4putimg after window operations..."
    redraw 1
    cv4putimg 2
    if stat : dialog "cv4putimg FAILED after wait_key" : end
    cv4info 2, px, py, _
    pos 10, 130
    color 0, 128, 0
    mes strf("  cv4putimg OK: %d x %d (no SEH crash)", px, py)
    redraw 1

    cv4save 2, "after_wait.png"
    pos 10, 160
    color 0, 0, 192
    mes "  saved -> after_wait.png"

    cv4del 0
    cv4del 1
    cv4del 2
    cv4_close_all

    pos 10, 200
    color 0, 0, 0
    mes ""
    mes "All advanced GUI ops succeeded."
    mes "Close this window to exit."
    redraw 1
    stop
