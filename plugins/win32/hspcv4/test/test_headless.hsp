;
;  hspcv4 headless self-test
;  CI/自動テスト用 — GUI を使わずコア API 9 命令を一通り検証します。
;  成功時に "ALL PASSED" を出力し exit 0、失敗時は "FAIL" を含む行を出力し exit 1。
;
#include "hspcv4.as"

    mes "=== hspcv4 Phase 1 headless test ==="

    ; --- cv4load ---
    cv4load 0, "test_image.png"
    if stat < 0 { mes "cv4load FAIL" : end 1 }
    mes "cv4load OK"

    ; --- cv4info ---
    cv4info 0, sx, sy, ch
    if (sx <= 0) | (sy <= 0) | (ch <= 0) { mes "cv4info FAIL" : end 1 }
    mes strf("cv4info OK: %d x %d ch=%d", sx, sy, ch)

    ; --- cv4resize ---
    cv4resize 1, 0, 320, 240
    if stat < 0 { mes "cv4resize FAIL" : end 1 }
    cv4info 1, sx2, sy2, _
    if (sx2 != 320) | (sy2 != 240) { mes "cv4resize size FAIL" : end 1 }
    mes strf("cv4resize OK: %d x %d", sx2, sy2)

    ; --- cv4cvt BGR -> GRAY ---
    cv4cvt 2, 1, CV4_BGR2GRAY
    if stat < 0 { mes "cv4cvt FAIL" : end 1 }
    cv4info 2, gx, gy, gch
    if gch != 1 { mes "cv4cvt channel FAIL" : end 1 }
    mes strf("cv4cvt OK: %d x %d ch=%d", gx, gy, gch)

    ; --- cv4save ---
    cv4save 2, "out_gray.png"
    if stat < 0 { mes "cv4save FAIL" : end 1 }
    mes "cv4save OK -> out_gray.png"

    ; --- cv4load saved file to verify roundtrip ---
    cv4load 3, "out_gray.png"
    if stat < 0 { mes "cv4load roundtrip FAIL" : end 1 }
    cv4info 3, rx, ry, rch
    if (rx != 320) | (ry != 240) { mes "cv4 roundtrip size FAIL" : end 1 }
    mes strf("cv4 roundtrip OK: %d x %d ch=%d", rx, ry, rch)

    ; --- drawing on Mat handle 1 (320x240 color) ---
    cv4line   1, 10, 10, 310, 230,   0,   0, 255, 2
    if stat < 0 { mes "cv4line FAIL" : end 1 }
    cv4rect   1, 50, 50, 100,  80,   0, 255,   0, 3
    if stat < 0 { mes "cv4rect FAIL" : end 1 }
    cv4circle 1, 200, 120, 40, 255,   0,   0, -1
    if stat < 0 { mes "cv4circle FAIL" : end 1 }
    cv4text   1, "hello", 20, 220, 0.8, 255, 255, 255, 2
    if stat < 0 { mes "cv4text FAIL" : end 1 }
    mes "cv4line/rect/circle/text OK"

    ; 描画結果を保存して再 load し、サイズが変わっていないこと (= 破壊されて
    ; いないこと) と、読み込めること (ファイル形式として有効) を確認する。
    cv4save 1, "out_drawn.png"
    if stat < 0 { mes "cv4save drawn FAIL" : end 1 }
    cv4load 4, "out_drawn.png"
    if stat < 0 { mes "cv4load drawn FAIL" : end 1 }
    cv4info 4, dx, dy, dch
    if (dx != 320) | (dy != 240) { mes "drawn roundtrip size FAIL" : end 1 }
    mes strf("drawing roundtrip OK: %d x %d ch=%d", dx, dy, dch)

    ; --- cv4del / cv4reset ---
    cv4del 0
    cv4del 1
    cv4del 2
    cv4del 3
    cv4del 4
    cv4reset
    mes "cv4del/cv4reset OK"

    mes ""
    mes "ALL PASSED"
    end 0
