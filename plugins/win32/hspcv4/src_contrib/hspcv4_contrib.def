; hspcv4_contrib.dll export definitions
; x86 で __stdcall 名前修飾 (_name@N) が付くのを防いで、
; 両アーキで同じ名前 (cv4_xxx_impl) で GetProcAddress できるようにする。
LIBRARY hspcv4_contrib
EXPORTS
    cv4_contrib_version_impl
    cv4_tracker_create_csrt_impl
    cv4_tracker_create_kcf_impl
    cv4_star_detect_impl
    cv4_harris_laplace_detect_impl
    cv4_brief_compute_impl
    cv4_freak_compute_impl
    cv4_daisy_compute_impl
    cv4_bgsub_create_cnt_impl
    cv4_bgsub_create_gmg_impl
    cv4_bgsub_create_lsbp_impl
    cv4_bgsub_create_gsoc_impl
    cv4_bgsub_create_mog_impl
    cv4_thinning_impl
    cv4_niblack_impl
    cv4_anisotropic_diffusion_impl
    cv4_guided_filter_impl
    cv4_l0_smooth_impl
    cv4_fast_global_smoother_impl
    cv4_weighted_median_impl
