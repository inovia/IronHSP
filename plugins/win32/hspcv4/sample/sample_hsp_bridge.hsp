;
;   sample_hsp_bridge.hsp
;   HSP 画面と cv::Mat の相互転送サンプル。
;   HSP で描いた内容を cv4putimg で取り込んで、OpenCV 側でぼかし処理
;   をかけ、cv4getimg で画面に書き戻す。
;
#include "hspcv4.as"

    title "hspcv4 sample: HSP<->OpenCV bridge"
    screen 0, 640, 480
    cls 4

    ; HSP 側で適当に描画
    color 255, 255, 0 : boxf  20,  20, 300, 200
    color   0, 255, 0 : boxf 320,  20, 600, 200
    color 255,   0, 0 : boxf  20, 220, 300, 400
    color   0,   0, 255 : boxf 320, 220, 600, 400
    color 255, 255, 255 : pos 60, 60
    mes "HSP drawing"

    redraw 1

    ; HSP 画面を OpenCV に取り込み
    cv4putimg 0
    if stat : dialog "cv4putimg failed" : end

    ; ガウシアンぼかし 21px
    cv4gauss  1, 0, 21, 7.0

    ; HSP 画面に書き戻し
    redraw 0
    cv4getimg 1
    redraw 1

    pos 10, 420 : color 0, 0, 0
    mes "above is the blurred version via cv4putimg -> cv4gauss -> cv4getimg"

    cv4save 1, "out_bridge_blurred.png"
    cv4del 0
    cv4del 1
    stop
