;
;   sample_drawing.hsp
;   hspcv4 描画命令のサンプル
;
#include "hspcv4.as"

    title "hspcv4 sample: drawing"
    screen 0, 640, 480
    cls 0

    ; 空の 600x400 黒画像を作る (test_image を読んで塗りつぶす流用)
    cv4load 0, "test_image.png"
    cv4resize 1, 0, 600, 400
    cv4rect   1, 0, 0, 600, 400, 30, 30, 30, -1    ; 塗りつぶしで背景色

    ; 描画 4 種
    cv4line   1,  50,  50, 550,  50,   0, 255, 255, 3    ; 黄色の横線
    cv4line   1,  50,  50,  50, 350,   0, 255, 255, 3    ; 黄色の縦線
    cv4rect   1, 100, 100, 200, 150,   0, 200,   0, 2    ; 緑の枠
    cv4rect   1, 320, 100, 200, 150,   0,   0, 255, -1   ; 赤塗りつぶし
    cv4circle 1, 150, 275,  50, 255, 255,   0, 3         ; シアン
    cv4circle 1, 300, 275,  50, 255,   0, 255, -1        ; マゼンタ塗り
    cv4circle 1, 450, 275,  50,   0, 165, 255, 2         ; オレンジ
    cv4text   1, "hspcv4 drawing demo", 80, 380, 0.9,  255, 255, 255, 2

    redraw 0
    cv4getimg 1
    redraw 1

    cv4save 1, "out_drawing.png"
    cv4del 0
    cv4del 1

    pos 10, 440 : color 255, 255, 255
    mes "saved -> out_drawing.png"
    stop
