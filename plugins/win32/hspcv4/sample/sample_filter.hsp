;
;   sample_filter.hsp
;   hspcv4 フィルタ命令のデモ。4 種のフィルタ結果を並べて表示する。
;
#include "hspcv4.as"

    title "hspcv4 sample: filters"
    screen 0, 820, 620
    cls 4

    cv4load 0, "test_image.png"
    cv4resize 1, 0, 400, 300     ; ベースをリサイズ

    ; フィルタ各種
    cv4gauss  2, 1, 15, 3.0      ; ガウシアンぼかし
    cv4median 3, 1, 9            ; メジアン
    cv4cvt    4, 1, CV4_BGR2GRAY ; グレースケール化
    cv4canny  5, 4, 80, 160      ; エッジ検出
    cv4thresh 6, 4, 0, 255, CV4_THRESH_BINARY | CV4_THRESH_OTSU  ; 大津二値化

    ; それぞれラベル付きで並べる用のキャンバスを作成
    cv4resize 10, 1, 820, 620
    cv4rect   10, 0, 0, 820, 620, 30, 30, 30, -1

    ; 2x3 グリッドにフィルタ結果を配置
    ; 各セル 400x300 + ラベル領域
    dim ids, 6
    ids(0) = 1   ; original
    ids(1) = 2   ; gauss
    ids(2) = 3   ; median
    ids(3) = 5   ; canny (1ch)
    ids(4) = 6   ; otsu  (1ch)
    ids(5) = 4   ; gray  (1ch)

    ; 注: cv4getimg は常に (0,0) から貼るので、画像を組み合わせるには
    ;     HSP 側で cv4 画像を 1 枚ずつ転送 → 位置を変えて mes等、の
    ;     手順を踏む必要がある。ここでは簡単に原画像のみ cv4getimg する。

    redraw 0
    cv4getimg 1
    redraw 1

    pos 10, 320 : color 255, 255, 0
    mes "top-left: original (displayed via cv4getimg)"
    mes "also saved each filter result:"
    cv4save 2, "out_gauss.png"
    cv4save 3, "out_median.png"
    cv4save 5, "out_canny.png"
    cv4save 6, "out_otsu.png"
    cv4save 4, "out_gray.png"
    mes "  out_gauss.png / out_median.png / out_canny.png"
    mes "  out_otsu.png  / out_gray.png"

    ; 解放
    repeat 7
        cv4del cnt
    loop
    cv4del 10
    stop
