	#include "iron_ribbon_native.hsp"

	screen 0, 800, 600
	title "Ribbon Framework Test"

	; Initialize ribbon
	ribbon_native_init
	mes "init: " + stat

	; Load BML (pre-compiled)
	ribbon_native_load_bml dir_cur + "\\ribbon.bml"
	mes "load_bml: " + stat

	mes "Ribbon height: " + ribbon_native_height()
	mes ""
	mes "Click ribbon buttons!"
	mes "Commands: New=101, Open=102, Save=103"
	mes "          Cut=104, Copy=105, Paste=106"
	mes "          Bold=107, Exit=108"

	*main
	await 50
	ribbon_native_poll
	if stat == 1 {
		cmd = ribbon_native_cmd_id()
		verb = ribbon_native_cmd_verb()
		mes "CMD: " + cmd + " VERB: " + verb
		if cmd == 108 {
			ribbon_native_destroy
			end
		}
	}
	goto *main
