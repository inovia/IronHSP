	#include "iron_ribbon_native.hsp"

	screen 0, 900, 600
	title "Windows Ribbon Framework - Full Demo"

	; Initialize
	ribbon_native_init
	mes "init: " + stat

	; Full auto build: XML → uicc → rc → link → DLL → LoadUI
	sdkbin = "C:\\Program Files (x86)\\Windows Kits\\10\\bin\\10.0.26100.0\\x86"
	ribbon_native_load_xml dir_cur + "\\ribbon.xml", sdkbin
	mes "load_xml: " + stat

	h = ribbon_native_height()
	mes "Ribbon height: " + h + "px"

	; Enable event mode (oncmd で受信)
	; WM_APP + 200 = 0x80C8
	ribbon_native_set_event_mode 1, 0x80C8

	mes ""
	mes "Click any ribbon button!"

	oncmd gosub *on_ribbon, 0x80C8
	stop

*on_ribbon
	cmd = wparam
	verb = lparam
	mes "Event: CMD=" + cmd + " VERB=" + verb
	if cmd == 999 {
		ribbon_native_destroy
		end
	}
	return
