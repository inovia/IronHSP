# Visual Studio ビルド出力ディレクトリ
Debug/
Release/
x64/
hsprt/
hsprt-unicode/
Debug-unicode/
Release-unicode/
Release_test/
Debug_test/
Release_test_*/
Debug_test_*/

# Visual Studio 隠しフォルダ
.vs/

# コンパイル中間ファイル
*.obj
*.pch
*.ipch
*.iobj
*.ipdb
*.tlog
*.lastbuildstate

# リンカ出力（lib/以下のサードパーティは除く）
*.ilk
*.idb
*.pdb
*.exp

# プリコンパイル済みヘッダ
*.gch

# IntelliSense / ブラウズDB
*.sdf
*.opensdf
*.VC.db
*.VC.db-shm
*.VC.db-wal
*.VC.opendb
*.ncb
*.aps
*.suo

# ユーザー固有の設定
*.vcxproj.user

# third_party で git clone / DL する外部 SDK (リポジトリには含めない)
plugins/win32/hspwasm/third_party/wasm3/*
!plugins/win32/hspwasm/third_party/wasm3/README.md
plugins/win32/hsptflite/third_party/tflite/include/
plugins/win32/hsptflite/third_party/tflite/lib/
!plugins/win32/hsptflite/third_party/tflite/README.md

# llama.cpp prebuilt SDK (大きいので README で DL 手順のみ)
plugins/win32/hspllama/third_party/llamacpp/include/
plugins/win32/hspllama/third_party/llamacpp/lib/
plugins/win32/hspllama/third_party/llamacpp/bin/
!plugins/win32/hspllama/third_party/llamacpp/README.md

# MediaPipe .tflite モデル (大きいので DL 手順のみリポジトリに)
package/win32/sample/iron/mediapipe_models/*.tflite
package/win32/sample/iron/mediapipe_models/*.task
