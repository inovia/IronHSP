;============================================================
;   sample_sound.hsp — Phase 1.7 動作確認 (mmload / mmplay / mmstop)
;
;   BGM は mmload オプション 1 でループ再生、SE はスペースで発音。
;
;   前提: 同ディレクトリに test_bgm.wav / test_se.wav を配置
;
;   ビルド: ..\..\..\package\win32\hspcmp64.exe -i sample_sound.hsp
;============================================================
#bootopt hsp64 1
#cmpopt utf8 1

    title "hsp3dx sample: sound"

    ;  ID 0 = BGM (loop), ID 1 = SE (one-shot)
    mmload "test_bgm.wav", 0, 1
    mmload "test_se.wav",  1, 0

    ;  BGM 再生開始
    mmplay 0

    se_count = 0

*main_loop
    redraw 0

    color 20, 30, 70
    boxf 0, 0, 640, 480

    ;  入力取得
    stick key, 16, 1        ; 16 = space を連射扱いにしない (nonstop bit)
    if key & 16 {
        mmplay 1            ; スペースで SE
        se_count = se_count + 1
    }
    if key & 0x100 {         ; ESC
        mmstop              ; 全停止
        end
    }

    color 255, 255, 255
    font "MS Gothic", 18
    pos 20, 20
    mes "Phase 1.7: 音声テスト"
    pos 20, 60
    mes "BGM (test_bgm.wav) をループ再生中"
    pos 20, 90
    mes "SPACE で SE (test_se.wav) 再生"
    pos 20, 120
    mes "ESC で全停止して終了"
    pos 20, 180
    mes "SE 再生回数: " + se_count

    redraw 1
    await 16
    goto *main_loop
