;============================================================
;   sample_ccmd.hsp — Phase 5.5p: 関数形式 DxLib 命令 (自動生成)
;
;   1144 個の DxLib 関数が `_f` サフィックス付きで式として呼び出せる。
;   (スカラー戻り値 + スカラー引数のみ、ref 引数/struct は不可)
;============================================================
#bootopt hsp64 1
#cmpopt utf8 1
#include "iron_dxlib.as"

    title "hsp3dx: #ccmd auto-gen 関数形式"

    color 15, 20, 40
    boxf 0, 0, 640, 480
    font "MS Gothic", 14
    color 255, 220, 80
    pos 10, 10

    ;  ---- 式形式の呼び出し (dx_Xxx_f は #ccmd で登録済) ----
    col_red   = dx_GetColor_f(255, 0, 0)
    col_green = dx_GetColor_f(0, 255, 0)
    col_blue  = dx_GetColor_f(0, 0, 255)

    rand1 = dx_GetRand_f(99)
    rand2 = dx_GetRand_f(99)
    rand3 = dx_GetRand_f(99)

    tick = dx_GetNowCount_f(0)          ; ミリ秒カウント

    mes "Phase 5.5p: #ccmd 自動生成 式形式関数"
    mes ""
    mes "(1) 色コード (GetColor)"
    mes "    dx_GetColor_f(255,0,0) = " + col_red
    mes "    dx_GetColor_f(0,255,0) = " + col_green
    mes "    dx_GetColor_f(0,0,255) = " + col_blue
    mes ""
    mes "(2) 乱数 (GetRand)"
    mes "    dx_GetRand_f(99) × 3 回  = " + rand1 + ", " + rand2 + ", " + rand3
    mes ""
    mes "(3) tick (GetNowCount)"
    mes "    dx_GetNowCount_f(0) = " + tick + "  (ms)"

    pos 10, 450
    color 255, 220, 80
    mes "[ESC] quit"
    redraw 1

    repeat
        await 16
        getkey esc_p, 27
        if esc_p : break
    loop
    end
