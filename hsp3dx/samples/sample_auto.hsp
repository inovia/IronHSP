;============================================================
;   sample_auto.hsp — Phase 5.3 自動生成 dx_* 命令の動作確認
;
;   auto-gen された命令の一部を実際に呼んでみる。
;
;   ビルド: ..\..\..\package\win32\hspcmp64.exe -i sample_auto.hsp
;============================================================
#bootopt hsp64 1
#cmpopt utf8 1
#include "iron_dxlib.as"

    title "hsp3dx sample: auto-gen dx_* commands (Phase 5.5)"

    ;  背景 & 文字準備
    color 20, 30, 60
    boxf 0, 0, 640, 480
    color 255, 255, 255
    font "MS Gothic", 16

    ;  ---- auto-gen 命令を呼んでみる (Phase 5.5d で CamelCase に変更済) ----
    dx_GetNowCount                      ; stat に tick count
    tick = stat

    dx_GetRand 999                      ; stat に 0..999 の乱数
    r1 = stat
    dx_GetRand 999
    r2 = stat

    dx_SleepThread 1                    ; 1ms sleep (CPU 譲渡)
    dx_SetAlwaysRunFlag 1               ; バックグラウンドでも動く

    ;  ---- 出力表示 ----
    pos 20, 20 : mes "Phase 5.5: 自動生成 1585 関数のうち 3 個を呼ぶデモ"
    pos 20, 50 : mes "dx_GetNowCount → " + tick + " ms"
    pos 20, 80 : mes "dx_GetRand 999 → " + r1 + ", " + r2
    pos 20, 110 : mes "dx_SleepThread / dx_SetAlwaysRunFlag 呼出済"
    pos 20, 150 : mes "総 extcmd 数 = 77 (手書き) + 1585 (auto-gen) = 1662"
    pos 20, 200 : mes "int/uint/float/double/int64/struct 戻り値、ref 引数すべて対応。"
    pos 20, 450 : mes "[ESC] quit"

    redraw 1

    repeat
        await 16
        getkey esc_p, 27
        if esc_p : break
    loop
    end
