;============================================================
;   sample_auto.hsp — Phase 5.3 自動生成 dx_* 命令の動作確認
;
;   auto-gen された命令の一部を実際に呼んでみる。
;
;   ビルド: ..\..\..\package\win32\hspcmp64.exe -i sample_auto.hsp
;============================================================
#bootopt hsp64 1
#cmpopt utf8 1
#include "iron_dxlib_auto.as"

    title "hsp3dx sample: auto-gen dx_* commands (Phase 5.3)"

    ;  背景 & 文字準備
    color 20, 30, 60
    boxf 0, 0, 640, 480
    color 255, 255, 255
    font "MS Gothic", 16

    ;  ---- auto-gen 命令を呼んでみる ----
    dx_get_now_count                    ; stat に tick count
    tick = stat

    dx_get_rand 999                     ; stat に 0..999 の乱数
    r1 = stat
    dx_get_rand 999
    r2 = stat

    dx_sleep_thread 1                   ; 1ms sleep (CPU 譲渡)
    dx_set_always_run_flag 1            ; バックグラウンドでも動く

    ;  ---- 出力表示 ----
    pos 20, 20 : mes "Phase 5.3: 自動生成 512 関数のうち 3 個を呼ぶデモ"
    pos 20, 50 : mes "dx_get_now_count → " + tick + " ms"
    pos 20, 80 : mes "dx_get_rand 999 → " + r1 + ", " + r2
    pos 20, 110 : mes "dx_sleep_thread / dx_set_always_run_flag 呼出済"
    pos 20, 150 : mes "総 extcmd 数 = 40+ (手書き) + 512 (auto-gen) = 552+"
    pos 20, 200 : mes "これで DxLib のほとんどの int 返し関数が HSP から使える。"
    pos 20, 240 : mes "(VECTOR / 構造体 / callback 付きは Phase 6 で対応予定)"
    pos 20, 450 : mes "[ESC] quit"

    redraw 1

    repeat
        await 16
        getkey esc_p, 27
        if esc_p : break
    loop
    end
