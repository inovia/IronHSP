;============================================================
;   test_web_draw.hsp — Web 描画パイプライン検証 (フォント不要)
;
;   box / circle / line を描いてしばらく表示してから end。
;   Web では font が無効なので mes は使わない。
;============================================================
#bootopt hsp64 1
#cmpopt utf8 1
#include "iron_dxlib.as"

    ;  背景を濃紺で塗る
    color 30, 50, 100
    boxf 0, 0, 640, 480

    ;  色付き box
    color 255, 100, 100 : boxf 50, 50, 200, 200    ; red
    color 100, 255, 100 : boxf 250, 50, 400, 200   ; green
    color 100, 100, 255 : boxf 450, 50, 600, 200   ; blue

    ;  円
    color 255, 220, 0
    circle 100, 350, 80, 1
    color 200, 100, 255
    circle 320, 350, 80, 1
    color 100, 255, 220
    circle 540, 350, 80, 1

    ;  斜めライン
    color 255, 255, 255
    line 0,   0, 640, 480
    line 640, 0,   0, 480

    ;  画面更新を確実に
    redraw 1

    ;  3 秒間表示してから end
    wait 300

    end
