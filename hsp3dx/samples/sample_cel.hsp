;============================================================
;   sample_cel.hsp — Phase 1.11 celdiv / celputm / gmulcolor / gfilter / rgbcolor / pget
;
;   前提: 同ディレクトリに test_sprites.png (128x32 で 32x32 4 フレーム)
;
;   ビルド: ..\..\..\package\win32\hspcmp64.exe -i sample_cel.hsp
;============================================================
#bootopt hsp64 1
#cmpopt utf8 1

    title "hsp3dx sample: sprite sheet (celdiv + celput)"

    ;  スプライトシートを ID=1 にロード、32x32 4 コマに分割
    celload "test_sprites.png", 1
    celdiv 1, 32, 32, 0, 0

    t = 0

*main_loop
    redraw 0
    color 30, 40, 80
    boxf 0, 0, 640, 480

    ;  ---- 4 フレームを順に表示 (左から) ----
    pos 40, 100
    celput 1, 0          ; frame 0 (赤)
    pos 100, 100
    celput 1, 1          ; frame 1 (緑)
    pos 160, 100
    celput 1, 2          ; frame 2 (青)
    pos 220, 100
    celput 1, 3          ; frame 3 (黄)

    ;  ---- アニメーション (4 フレームをループ) ----
    anim_frame = (t / 10) \ 4
    pos 400, 100
    celput 1, anim_frame, 3.0, 3.0      ; 3 倍に拡大

    ;  ---- gmulcolor: 各 RGB チャネルに比率乗算 (色置換ではなく濃度調整) ----
    ;  赤スプライト (R=255,G=80,B=80) × (128,255,128)
    ;    R: 255*0.5=127、G: 80*1=80、B: 80*0.5=40 → (127,80,40) = 茶色
    ;  色を置き換えたい場合は元のスプライトに全チャネル成分が必要 (白が最適)。
    gmulcolor 128, 255, 128
    pos 40, 200
    celput 1, 0, 2.0, 2.0
    gmulcolor 255, 255, 255             ; リセット

    ;  ---- gfilter: 線形補間 (ぼかし) で拡大 ----
    gfilter 1
    pos 200, 200
    celput 1, 1, 4.0, 4.0
    gfilter 0                           ; 最近傍 (デフォルト) に戻す

    ;  ---- rgbcolor: パック RGB 値を s_cur_color にセット ----
    rgbcolor 0x80E0FF
    pos 400, 220
    mes "rgbcolor 0x80E0FF"

    ;  ---- pget: 画面中央のピクセルを読む ----
    pget 320, 240
    px = stat

    color 255, 255, 255
    font "MS Gothic", 14
    pos 10, 10 : mes "Phase 1.11: celdiv / celputm / gmulcolor / gfilter / rgbcolor / pget"
    pos 10, 30 : mes "上段: frame 0-3 等寸 / 右: frame アニメ 3x 拡大"
    pos 10, 50 : mes "下段: gmulcolor tint / gfilter linear / rgbcolor / pget"
    pos 10, 460 : mes "pget(320,240) = " + px + " (HSP hex 0xRRGGBB)   [ESC] quit"

    redraw 1

    getkey esc_p, 27
    if esc_p : end

    t = t + 1
    await 16
    goto *main_loop
