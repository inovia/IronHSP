<?xml version="1.0" encoding="utf-8"?>
<!--
    hsp3dx.vcxproj — Windows 版 hsp3dx.exe (Phase 1.0 スケルトン)

    本 vcxproj は hsp3dx/src/ 配下のスケルトンソースと DxLib SDK を参照してビルドする。
    現状 VM (hsp3embed) は未リンク、Phase 1.1 で追加する。

    前提:
      hsp3dx/extlib/dxlib_win/include/DxLib.h
      hsp3dx/extlib/dxlib_win/lib/x64/DxLib_x64.lib
    を手動配置 (extlib/dxlib_win/README.md 参照)
-->
<Project DefaultTargets="Build" ToolsVersion="17.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">

  <ItemGroup Label="ProjectConfigurations">
    <ProjectConfiguration Include="Debug|x64">
      <Configuration>Debug</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Release|x64">
      <Configuration>Release</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
  </ItemGroup>

  <PropertyGroup Label="Globals">
    <ProjectGuid>{A3D21000-3DX1-4DX1-BDX1-000000000001}</ProjectGuid>
    <RootNamespace>hsp3dx</RootNamespace>
    <Keyword>Win32Proj</Keyword>
    <WindowsTargetPlatformVersion>10.0</WindowsTargetPlatformVersion>
  </PropertyGroup>

  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.Default.props" />

  <PropertyGroup Condition="'$(Configuration)'=='Debug'" Label="Configuration">
    <ConfigurationType>Application</ConfigurationType>
    <PlatformToolset>v143</PlatformToolset>
    <CharacterSet>MultiByte</CharacterSet>
    <UseDebugLibraries>true</UseDebugLibraries>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)'=='Release'" Label="Configuration">
    <ConfigurationType>Application</ConfigurationType>
    <PlatformToolset>v143</PlatformToolset>
    <CharacterSet>MultiByte</CharacterSet>
    <UseDebugLibraries>false</UseDebugLibraries>
    <WholeProgramOptimization>true</WholeProgramOptimization>
  </PropertyGroup>

  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.props" />

  <PropertyGroup>
    <OutDir>$(SolutionDir)bin\$(Configuration)\</OutDir>
    <IntDir>$(SolutionDir)obj\$(Configuration)\</IntDir>
    <TargetName>hsp3dx</TargetName>
  </PropertyGroup>

  <ItemDefinitionGroup>
    <ClCompile>
      <AdditionalIncludeDirectories>
        $(ProjectDir)..\src;
        $(ProjectDir)..\extlib\dxlib_win\DxLib_VC;
        $(ProjectDir)..\..\hsp3;
        $(ProjectDir)..\..\hsp3embed;
        %(AdditionalIncludeDirectories)
      </AdditionalIncludeDirectories>
      <PreprocessorDefinitions>
        _HSP64;HSP64;HSP3DX;HSPWIN;HSPUTF8;UNICODE;_UNICODE;WIN32;_WINDOWS;_CRT_SECURE_NO_WARNINGS;
        %(PreprocessorDefinitions)
      </PreprocessorDefinitions>
      <RuntimeLibrary Condition="'$(Configuration)'=='Debug'">MultiThreadedDebug</RuntimeLibrary>
      <RuntimeLibrary Condition="'$(Configuration)'=='Release'">MultiThreaded</RuntimeLibrary>
      <LanguageStandard>stdcpp17</LanguageStandard>
      <WarningLevel>Level3</WarningLevel>
      <Optimization Condition="'$(Configuration)'=='Release'">MaxSpeed</Optimization>
      <!-- hsp3dx ソースは UTF-8 (BOM なし)。MSVC にも UTF-8 として解釈させる。
           /wd4828 は DxLib.h 内の SJIS 日本語コメントで出る警告を抑制 (我々のコードは無関係) -->
      <AdditionalOptions>/utf-8 /wd4828 %(AdditionalOptions)</AdditionalOptions>
    </ClCompile>
    <Link>
      <SubSystem>Windows</SubSystem>
      <AdditionalLibraryDirectories>
        $(ProjectDir)..\extlib\dxlib_win\DxLib_VC;
        %(AdditionalLibraryDirectories)
      </AdditionalLibraryDirectories>
      <!--
          DxLib 本体と依存ライブラリ (libjpeg/libpng/libtheora/bullet 等) は DxLib.h 内の
          #pragma comment(lib, ...) により自動リンクされる。ここでは Windows 標準 lib のみ列挙。
      -->
      <AdditionalDependencies>
        user32.lib;gdi32.lib;ole32.lib;oleaut32.lib;winmm.lib;shell32.lib;
        %(AdditionalDependencies)
      </AdditionalDependencies>
      <GenerateDebugInformation>true</GenerateDebugInformation>
    </Link>
  </ItemDefinitionGroup>

  <ItemGroup>
    <!-- hsp3dx アプリシェル + hgio_dx -->
    <ClCompile Include="..\src\main.cpp" />
    <ClCompile Include="..\src\hgio_dx.cpp" />
    <ClCompile Include="..\src\hsp3dxcl.cpp" />
    <ClCompile Include="..\src\hsp3dx_stubs.cpp" />
  </ItemGroup>
  <ItemGroup>
    <ClInclude Include="..\src\hgio_dx.h" />
    <ClInclude Include="..\src\hsp3dxcl.h" />
  </ItemGroup>

  <ItemGroup>
    <!-- HSP3 VM コア (Phase 1.1: hsp3/ 配下の platform-agnostic ソース 19 ファイル) -->
    <ClCompile Include="..\..\hsp3\hsp3.cpp" />
    <ClCompile Include="..\..\hsp3\hsp3code.cpp" />
    <ClCompile Include="..\..\hsp3\hsp3crypt.cpp" />
    <ClCompile Include="..\..\hsp3\hsp3debug.cpp" />
    <ClCompile Include="..\..\hsp3\hsp3int.cpp" />
    <ClCompile Include="..\..\hsp3\hsp3utfcnv.cpp" />
    <ClCompile Include="..\..\hsp3\hspvar_core.cpp" />
    <ClCompile Include="..\..\hsp3\hspvar_double.cpp" />
    <ClCompile Include="..\..\hsp3\hspvar_int.cpp" />
    <ClCompile Include="..\..\hsp3\hspvar_int64.cpp" />
    <ClCompile Include="..\..\hsp3\hspvar_label.cpp" />
    <ClCompile Include="..\..\hsp3\hspvar_str.cpp" />
    <ClCompile Include="..\..\hsp3\hspvar_struct.cpp" />
    <ClCompile Include="..\..\hsp3\hspvar_wstr.cpp" />
    <ClCompile Include="..\..\hsp3\stack.cpp" />
    <ClCompile Include="..\..\hsp3\strbuf.cpp" />
    <ClCompile Include="..\..\hsp3\strnote.cpp" />
    <ClCompile Include="..\..\hsp3\dpmread.cpp" />
    <ClCompile Include="..\..\hsp3\filepack.cpp" />
    <!-- プラットフォーム依存 I/O ユーティリティ (Win+UTF8 版) -->
    <ClCompile Include="..\..\hsp3\win32gui\supio_win_unicode.cpp" />
  </ItemGroup>

  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />
</Project>
