; hello_watch.hsp — Phase 8 gosub + 文字列関数 demo + Phase 10 notify
;
; gosub で時刻文字列を組み立てる subroutine を呼び、 strmid / strlen / instr で
; 文字列を切り出して表示する。
; Phase 10: tap が増えるたびに haptic + ローカル通知を投函する。
;
#bootopt hsp64 1
#cmpopt utf8 1
#include "watch_api.as"

	greeting = "Hello, HSP on Watch!"
	count_label = "frame#"
	last_tap = 0
	booted = 0

	repeat
		cls

		; gosub でアニメ円計算
		gosub *update_pos

		; 起動から 30 frame (1 秒) 後に 1 回 boot 通知
		if cnt >= 30 : if booted = 0 {
			booted = 1
			notify "hsp3watch", "boot ok at frame=" + cnt
		}

		; tap 検出 → haptic + 通知 (Phase 10)
		if tapcnt != last_tap {
			last_tap = tapcnt
			haptic 1
			notify "Watch tap", "tap=" + tapcnt + " frame=" + cnt
		}

		; ガイド + 動く矩形
		color 40, 80, 100
		boxf 100 - 50, 75 - 50, 100 + 50, 75 + 50
		color 255, 80, 80
		boxf bx - 5, by - 5, bx + 5, by + 5

		; 文字列関数 demo
		head = strmid(greeting, 0, 5)        ; "Hello"
		tail = strmid(greeting, 7, 13)       ; "HSP on Watch!"
		hsplen = strlen(greeting)
		ww = instr(greeting, 0, "Watch")     ; 14

		color 200, 220, 255
		pos 4, 100
		mes "head=" + head

		color 100, 255, 200
		pos 4, 118
		mes "tail=" + tail

		color 255, 220, 100
		pos 4, 136
		mes "len=" + hsplen + " atW=" + ww

		color 255, 255, 255
		pos 4, 154
		mes count_label + cnt

		await 33
	loop

*update_pos
	theta = double(cnt) / 30.0 * 3.14159
	bx = int(100.0 + sin(theta) * 50.0)
	by = int(75.0  + cos(theta) * 50.0)
	return
