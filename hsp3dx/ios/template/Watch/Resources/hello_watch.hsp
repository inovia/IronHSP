; hello_watch.hsp — Phase 7 simplified
;
#bootopt hsp64 1
#cmpopt utf8 1
#include "watch_api.as"

	last_tap = 0

	repeat
		cls

		; 半径 = 50 + crown
		r = 50 + crown
		if r < 10 {
			r = 10
		}
		if r > 90 {
			r = 90
		}

		; 円軌道
		theta = double(cnt) / 30.0 * 3.14159
		x = 100.0 + sin(theta) * double(r)
		y = 75.0  + cos(theta) * double(r)

		; ガイド
		color 40, 80, 100
		boxf 100 - r, 75 - r, 100 + r, 75 + r

		; 動く矩形
		color 255, 80, 80
		boxf int(x) - 6, int(y) - 6, int(x) + 6, int(y) + 6

		; HUD
		color 255, 255, 255
		pos 4, 130
		mes "f=" + cnt

		color 200, 220, 255
		pos 4, 150
		mes "crown=" + crown

		color 255, 200, 100
		pos 4, 170
		mes "tap=" + tapcnt + " r=" + r

		; tap 検出 → haptic
		if tapcnt != last_tap {
			haptic 1
			last_tap = tapcnt
		}

		await 33
	loop
