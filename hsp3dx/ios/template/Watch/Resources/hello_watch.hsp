; hello_watch.hsp — Phase 3 animation
;
; Apple Watch 画面は 200pt 幅程度なので座標は控えめに。
;
#bootopt hsp64 1
#cmpopt utf8 1

	repeat
		cls

		; cnt 連動の赤矩形 (横軸を 0..120 で往復)
		x = (cnt \ 240) - 120
		if x < 0 {
			x = -x
		}
		x = x + 20
		color 240, 80, 80
		boxf x, 28, x + 40, 56

		; 3 本のサイアン横線
		color 80, 200, 240
		line 8, 70, 180, 70
		line 8, 78, 180, 78
		line 8, 86, 180, 86

		; cnt 表示
		color 255, 255, 255
		pos 8, 96
		mes "frame=" + cnt

		; 値もテスト (式評価が動いていることの証明)
		color 200, 220, 255
		pos 8, 116
		mes "x=" + x

		await 33
	loop
