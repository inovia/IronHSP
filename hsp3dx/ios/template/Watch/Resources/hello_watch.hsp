; hello_watch.hsp — Phase 5 sin/cos アニメ
;
; cnt 連動で円軌道に小さい矩形が回る。 中央に sin/cos の値も表示。
;
#bootopt hsp64 1
#cmpopt utf8 1

	repeat
		cls

		; 角度を cnt から計算 (1 周 = 120 frame)
		theta = double(cnt) / 60.0 * 3.14159

		; 中心 100, 75。 半径 50。
		x = 100.0 + sin(theta) * 50.0
		y = 75.0  + cos(theta) * 40.0

		; 軌跡円 (薄い色の輪郭)
		color 60, 60, 90
		boxf 50, 35, 150, 115

		; 動く矩形 (赤)
		color 240, 80, 80
		boxf int(x) - 8, int(y) - 8, int(x) + 8, int(y) + 8

		; HUD
		color 200, 220, 255
		pos 4, 130
		mes "f=" + cnt + " th=" + int(theta * 100)

		color 255, 255, 255
		pos 4, 150
		mes "x=" + int(x) + " y=" + int(y)

		; rnd で色変化テスト
		r = rnd(256)
		g = rnd(256)
		b = rnd(256)
		color r, g, b
		pos 4, 170
		mes "rnd=(" + r + "," + g + "," + b + ")"

		await 33
	loop
